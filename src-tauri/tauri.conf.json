{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WattWall",
  "version": "0.3.0",
  "identifier": "co.swatto.wattwall",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WattWall",
        "width": 880,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#161a1f",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Swatto",
    "copyright": "© 2026 Swatto",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Block chosen programs in Windows Firewall",
    "longDescription": "WattWall adds one-click blocks to the Windows Defender Firewall for the programs you choose.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Swatto86/WattWall/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwRTZGQzA2MDNEMDAyQTcKUldTbkF0QURCdnpta0M2azJNeHU1cmFIdUVvcmJ2SkNHQndvdGNZekMvb1NDR05nc00rcVlETi8K",
      "windows": { "installMode": "quiet" }
    }
  }
}
